# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

# The image GoReleaser publishes. It compiles nothing: the binary it copies is
# the same one the release archives carry, already stamped and already the
# artifact people download, so the image and the tarball cannot disagree about
# what they contain. The Dockerfile at the repository root is the other half of
# this pair and still compiles from source, for `docker build .` and `make
# docker-build`.
#
# TARGETPLATFORM is how GoReleaser lays the build context out: one directory
# per platform, each holding that platform's binary.
#
# There is no LABEL block here. GoReleaser passes the OCI labels on the build
# command line from .goreleaser.yaml, where the version, the commit and the
# date are known; a second copy in this file could only repeat them wrong.

# The state directory, made the same way and for the same reason as in the root
# Dockerfile: a named volume mounted over it takes its owner, uid 65532, where
# one Docker created on its own belonged to root and the collector could save
# neither its state nor its cache in it. WORKDIR makes the directory, since
# distroless has no shell to run mkdir with.
FROM scratch AS state
WORKDIR /var/lib/ghchronicle

# The base is the root Dockerfile's runtime stage, pinned to the same version
# and digest, so the two images differ only in where the binary came from.
# Change both together.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/ghchronicle /ghchronicle
COPY --from=state --chown=65532:65532 /var/lib/ghchronicle /var/lib/ghchronicle

# Numeric for the same reason as in the root Dockerfile: Kubernetes enforces
# runAsNonRoot only against a user it can read as a number.
USER 65532:65532

# Prometheus exporter.
EXPOSE 9605

ENTRYPOINT ["/ghchronicle"]
