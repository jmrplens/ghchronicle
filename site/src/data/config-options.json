  "action": {
    "inputs": [
      {
        "name": "token",
        "required": true,
        "default": ""
      },
      {
        "name": "config",
        "required": false,
        "default": ""
      },
      {
        "name": "user",
        "required": false,
        "default": "${{ github.repository_owner }}"
      },
      {
        "name": "mode",
        "required": false,
        "default": "once"
      },
      {
        "name": "backfill-since",
        "required": false,
        "default": ""
      },
      {
        "name": "card",
        "required": false,
        "default": ""
      },
      {
        "name": "card-layout",
        "required": false,
        "default": "summary"
      },
      {
        "name": "card-theme",
        "required": false,
        "default": "auto"
      },
      {
        "name": "card-fields",
        "required": false,
        "default": ""
      },
      {
        "name": "card-motion",
        "required": false,
        "default": "once"
      },
