    {
      "key": "sinks.file.keep",
      "kind": "int",
      "group": "sinks",
      "sink": "file",
      "example": "5"
    },
    {
      "key": "sinks.stdout",
      "kind": "bool",
      "group": "sinks",
      "default": "false",
      "example": "false"
    },
    {
      "key": "sinks.stdout_format",
      "kind": "string",
      "group": "sinks",
      "example": "influx",
