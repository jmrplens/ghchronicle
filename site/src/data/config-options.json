    {
      "key": "sinks.graphite.prefix",
      "kind": "string",
      "group": "sinks",
      "sink": "graphite",
      "default": "github",
      "example": "github"
    },
    {
      "key": "sinks.graphite.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "graphite",
      "example": "1000"
    },
    {
      "key": "sinks.graphite.dedupe",
      "kind": "bool",
      "group": "sinks",
      "sink": "graphite",
