      "example": "/metrics"
    },
    {
      "key": "sinks.prometheus.no_prime",
      "kind": "bool",
      "group": "sinks",
      "sink": "prometheus",
      "default": "false",
      "example": "false"
    },
    {
      "key": "sinks.otlp",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.otlp.endpoint",
      "kind": "string",
      "group": "sinks",
      "sink": "otlp",
      "required": true,
      "example": "http://collector:4318/v1/metrics"
    },
    {
      "key": "sinks.otlp.headers",
      "kind": "map",
      "group": "sinks",
      "sink": "otlp",
      "secret": true,
      "example": "Authorization: Bearer ${OTLP_TOKEN}"
    },
    {
      "key": "sinks.otlp.service",
      "kind": "string",
      "group": "sinks",
      "sink": "otlp",
      "example": "ghchronicle"
    },
    {
      "key": "sinks.otlp.raw",
      "kind": "bool",
      "group": "sinks",
      "sink": "otlp",
      "default": "false",
      "example": "false"
    },
    {
      "key": "sinks.otlp.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "otlp",
      "example": "2000"
    },
    {
      "key": "sinks.otlp.repeat",
      "kind": "string",
      "group": "sinks",
      "sink": "otlp",
      "example": "1m"
    },
    {
      "key": "sinks.loki",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.loki.url",
      "kind": "string",
      "group": "sinks",
      "sink": "loki",
      "required": true,
      "example": "http://loki:3100/loki/api/v1/push"
    },
    {
      "key": "sinks.loki.tenant_id",
      "kind": "string",
      "group": "sinks",
      "sink": "loki",
      "example": "tenant-one"
    },
    {
      "key": "sinks.loki.labels",
      "kind": "map",
      "group": "sinks",
      "sink": "loki",
      "example": "job: ghchronicle"
    },
    {
      "key": "sinks.loki.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "loki",
      "example": "1000"
    },
    {
      "key": "sinks.loki.max_age",
      "kind": "string",
      "group": "sinks",
      "sink": "loki",
      "example": "1h"
    },
    {
      "key": "sinks.file",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.file.path",
      "kind": "string",
