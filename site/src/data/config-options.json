    },
    {
      "key": "sinks.elasticsearch.api_key",
      "kind": "string",
      "group": "sinks",
      "sink": "elasticsearch",
      "secret": true,
      "example": "${ES_API_KEY}"
    },
    {
      "key": "sinks.elasticsearch.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "elasticsearch",
      "example": "1000"
    },
    {
      "key": "sinks.elasticsearch.dedupe",
      "kind": "bool",
      "group": "sinks",
      "sink": "elasticsearch",
      "default": "true",
      "example": "true"
