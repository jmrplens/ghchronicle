    },
    {
      "key": "sinks.telegraf.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "telegraf",
      "example": "5000"
    },
    {
      "key": "sinks.telegraf.dedupe",
      "kind": "bool",
      "group": "sinks",
      "sink": "telegraf",
      "default": "true",
      "example": "true"
    },
    {
      "key": "sinks.graphite",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.graphite.addr",
      "kind": "string",
      "group": "sinks",
