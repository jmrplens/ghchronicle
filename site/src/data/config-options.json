{
  "options": [
    {
      "key": "github",
      "kind": "block",
      "group": "github"
    },
    {
      "key": "github.token",
      "kind": "string",
      "group": "github",
      "secret": true,
      "required": true,
      "example": "${GITHUB_TOKEN}"
    },
    {
      "key": "github.base_url",
      "kind": "string",
      "group": "github",
      "example": "https://github.example.com/api/v3"
    },
    {
      "key": "github.web_url",
      "kind": "string",
      "group": "github",
      "example": "https://github.example.com"
    },
    {
      "key": "github.timeout",
      "kind": "string",
      "group": "github",
      "default": "30s",
      "example": "30s"
    },
    {
      "key": "github.reserve_rate",
      "kind": "int",
      "group": "github",
      "default": "500",
      "example": "500"
    },
    {
      "key": "targets",
      "kind": "block",
      "group": "targets"
    },
    {
      "key": "targets.user",
      "kind": "string",
      "group": "targets",
      "example": "your-github-login"
    },
    {
      "key": "targets.orgs",
      "kind": "list",
      "group": "targets",
      "example": "some-org, another-org"
    },
    {
      "key": "targets.repos",
      "kind": "list",
      "group": "targets",
      "example": "someone/one-repo"
    },
    {
      "key": "targets.exclude",
      "kind": "list",
      "group": "targets",
      "example": "someone/experiment-*"
    },
    {
      "key": "targets.include_forks",
      "kind": "bool",
      "group": "targets",
      "default": "false",
      "example": "false"
    },
    {
      "key": "targets.include_archived",
      "kind": "bool",
      "group": "targets",
      "default": "false",
      "example": "false"
    },
    {
      "key": "targets.include_private",
      "kind": "bool",
      "group": "targets",
      "default": "true",
      "example": "true"
    },
    {
      "key": "sinks",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.influxdb",
      "kind": "block",
      "group": "sinks"
    },
