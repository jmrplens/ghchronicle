    },
    {
      "key": "sinks.influxdb.org",
      "kind": "string",
      "group": "sinks",
      "sink": "influxdb",
      "default": "default",
      "example": "default"
    },
    {
      "key": "sinks.influxdb.bucket",
      "kind": "string",
      "group": "sinks",
      "sink": "influxdb",
      "required": true,
      "example": "github"
    },
    {
      "key": "sinks.influxdb.batch",
      "kind": "int",
      "group": "sinks",
      "sink": "influxdb",
      "example": "5000"
    },
    {
      "key": "sinks.influxdb.exclude",
      "kind": "list",
      "group": "sinks",
      "sink": "influxdb",
      "default": "gh_job_log",
      "example": "gh_job_log"
    },
    {
      "key": "sinks.influxdb.dedupe",
      "kind": "bool",
      "group": "sinks",
      "sink": "influxdb",
      "default": "true",
      "example": "true"
    },
    {
      "key": "sinks.prometheus",
      "kind": "block",
      "group": "sinks"
    },
    {
      "key": "sinks.prometheus.listen",
      "kind": "string",
      "group": "sinks",
      "sink": "prometheus",
      "default": ":9605",
      "example": "127.0.0.1:9605"
