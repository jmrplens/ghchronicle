      "default": "ghchronicle-state-written.bin",
      "example": "/var/lib/ghchronicle/state-written.bin"
    },
    {
      "key": "sinks.dedupe_horizon",
      "kind": "string",
      "group": "sinks",
      "default": "720h",
      "example": "720h"
    },
    {
      "key": "every",
      "kind": "block",
      "group": "cadences"
    },
    {
      "key": "every.default",
      "kind": "string",
      "group": "cadences",
      "example": "15m"
    },
    {
      "key": "every.groups",
      "kind": "map",
      "group": "cadences",
      "example": "ci: 1m",
      "keys": [
        "account",
        "audience",
        "ci",
        "collector",
        "feeds",
        "repos",
        "security",
        "work"
      ]
    },
    {
      "key": "every.families",
      "kind": "map",
      "group": "cadences",
      "example": "deps: 24h",
      "keys": [
        "account",
        "achievements",
        "actions",
        "activity",
        "analyses",
        "artifacts",
        "billing",
        "branches",
        "commits",
        "deployments",
        "deps",
        "discussions",
        "events",
        "forks",
        "history",
        "inventory",
        "issueevents",
        "issues",
        "joblogs",
        "keys",
        "notifs",
        "outbound",
        "planning",
        "policyfiles",
        "profile",
        "ratelimit",
        "repo",
        "rulesets",
        "security",
        "settings",
        "stars",
        "stats",
        "totals",
        "traffic"
      ]
    },
    {
      "key": "heartbeat",
      "kind": "string",
      "group": "run",
      "example": "15s"
    },
    {
      "key": "groups",
      "kind": "list",
      "group": "run",
      "example": "audience, account, repos",
      "keys": [
        "account",
        "audience",
        "ci",
        "collector",
        "feeds",
        "repos",
        "security",
        "work"
      ]
    },
    {
      "key": "log",
      "kind": "block",
      "group": "log"
    },
    {
      "key": "log.level",
      "kind": "string",
      "group": "log",
      "default": "info",
      "example": "info",
      "choices": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    {
      "key": "log.format",
      "kind": "string",
      "group": "log",
      "default": "text",
      "example": "text",
      "choices": [
        "text",
        "json"
      ]
    },
    {
      "key": "log.file",
      "kind": "string",
      "group": "log",
      "example": "/var/log/ghchronicle/ghchronicle.log"
    },
    {
      "key": "log.max_bytes",
      "kind": "int",
      "group": "log",
      "example": "67108864"
    },
    {
      "key": "log.keep",
      "kind": "int",
      "group": "log",
      "example": "5"
    },
    {
      "key": "state_file",
      "kind": "string",
      "group": "run",
      "default": "ghchronicle-state.json",
      "example": "/var/lib/ghchronicle/state.json"
    },
    {
      "key": "backfill",
      "kind": "block",
      "group": "run"
    },
    {
      "key": "backfill.since",
      "kind": "string",
      "group": "run",
      "example": "2y"
    }
  ],
  "groups": [
    {
      "name": "account",
      "description": "the account itself: its lifetime numbers, its profile, its keys, its spending and what it does in other people's repositories",
      "families": [
        "account",
        "achievements",
        "billing",
        "history",
        "keys",
        "outbound",
        "profile",
        "totals"
      ]
    },
    {
      "name": "audience",
      "description": "who is looking at the projects, who starred them and who copied them",
      "families": [
        "forks",
        "stars",
        "traffic"
      ]
    },
    {
      "name": "ci",
      "description": "continuous integration and deployment: runs, jobs, steps, artifacts, caches and deployments",
      "families": [
        "actions",
        "artifacts",
        "deployments",
        "joblogs"
      ]
    },
    {
      "name": "collector",
      "description": "what the collector has left to spend",
      "families": [
        "ratelimit"
      ]
    },
    {
      "name": "feeds",
      "description": "the three feeds GitHub keeps only briefly: the event feed, notifications and each repository's log",
      "families": [
        "activity",
        "events",
        "notifs"
      ]
    },
    {
      "name": "repos",
      "description": "what each repository is: metadata and releases, live branches, webhooks and environments, governance files, dependencies",
      "families": [
        "branches",
        "deps",
        "inventory",
        "policyfiles",
        "repo",
        "rulesets",
        "settings"
      ]
    },
    {
      "name": "security",
      "description": "Dependabot alerts and code scanning",
      "families": [
        "analyses",
        "security"
      ]
    },
    {
      "name": "work",
      "description": "the work done in them: pull requests, issues and their transitions, commits, discussions, labels and milestones",
      "families": [
        "commits",
        "discussions",
        "issueevents",
        "issues",
        "planning",
        "stats"
      ]
    }
  ],
  "families": [
    {
      "name": "account",
      "group": "account",
      "every": "12h"
    },
    {
      "name": "achievements",
