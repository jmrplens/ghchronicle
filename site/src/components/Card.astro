---
/**
 * One picture of the card, and for the layouts that animate, a way to see the
 * animation again.
 *
 * The pictures are the SVG the tool writes, loaded as images rather than
 * inlined: ten of them on one page would put ten `<style>` blocks into one
 * document, and they share class and keyframe names (`m0`, `m1`),
 * so the last one would restyle the other nine. An image is a document of its
 * own, which is what keeps each card's animation to itself.
 *
 * The same isolation is why replaying takes a new image rather than a class:
 * nothing on the page can reach inside an image to restart its animations. So
 * the button swaps the image for a new one under a query it has never used,
 * which the browser treats as a new picture and animates from the start. A new
 * query on every press, and not two alternated: once both of two URLs had been
 * shown, Safari kept each decoded picture and handed the same one back already
 * at its last frame, so only the first press replayed anything. The cost of a
 * press is one download of a few kilobytes.
 *
 * The button is present only where there is something to replay. On a card
 * that does not move it would be a control that does nothing, and it starts
 * hidden so a reader without JavaScript never meets one either.
 *
 * The twins invoke this component identically, which is what
 * `scripts/check-i18n-parity.mjs` compares, so the label's language is read off
 * the URL rather than passed in, the way `Figure.astro` reads it.
 */
import { BASE, localeOf } from "../lib/site.mjs";
import ThemeImage from "./ThemeImage.astro";

interface Props {
	/** The layout's name, which is the stem of its picture: card-<name>.svg. */
	name: string;
	/** What the picture shows, for a reader who cannot see it. */
	alt: string;
	/** Whether the layout animates, and so whether a replay button is offered. */
	animated?: boolean;
}

const { name, alt, animated = false } = Astro.props;

const route = Astro.url.pathname
	.slice(BASE.length)
	.replace(/^\/+/, "")
	.replace(/\/+$/, "");
const locale = localeOf(route);

const urls = import.meta.glob<string>("../assets/card-*.svg", {
	query: "?url",
	import: "default",
	eager: true,
});
const sources = import.meta.glob<string>("../assets/card-*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});

// Both palettes, light as the plain name and dark with the `_dark` suffix. The
// dark URL is looked up rather than derived, because Vite puts a content hash
// into every asset URL and a suffix added after it names no file.
const key = `../assets/card-${name}.svg`;
const darkKey = `../assets/card-${name}_dark.svg`;
const src = urls[key];
const darkSrc = urls[darkKey];
const raw = sources[key];
if (!src || !darkSrc || !raw) {
	throw new Error(
		`<Card name="${name}" /> needs both src/assets/card-${name}.svg and card-${name}_dark.svg. ` +
			"Render the gallery with TestCardGallery (see the testing page) and copy them in.",
	);
}

// The card's own size, read off its root element, so the page reserves the box
// before the image arrives and nothing below it moves when it does.
const root = raw.match(/<svg\b[^>]*>/)?.[0] ?? "";
const width = Number(root.match(/\bwidth="(\d+)"/)?.[1]);
const height = Number(root.match(/\bheight="(\d+)"/)?.[1]);
if (!width || !height) {
	throw new Error(`src/assets/card-${name}.svg declares no width and height on its root.`);
}

const LABELS = {
	en: "Replay the animation",
	es: "Repetir la animación",
};
const label = LABELS[locale];
---

<figure class="rb-card" data-card>
	<ThemeImage
		light={src}
		dark={darkSrc}
		alt={alt}
		width={width}
		height={height}
	/>
	{
		animated && (
			<button
				type="button"
				class="rb-card__replay"
				data-card-replay
				hidden
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M3 12a9 9 0 1 0 3-6.7" />
					<path d="M3 4v5h5" />
				</svg>
				<span>{label}</span>
			</button>
		)
	}
</figure>

<script>
	// One module however many cards the page holds: Astro bundles a component's
	// script once.
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-card-replay]")) {
		const figure = button.closest("[data-card]");
		if (!figure?.querySelector("img")) continue;
		button.addEventListener("click", () => {
			// The palette on screen. The other one is display:none, and a lazy
			// image there has usually never been fetched, so reloading it would
			// cost a download and replay nothing anyone can see.
			const current = [...figure.querySelectorAll("img")].find(
				(image) => getComputedStyle(image).display !== "none",
			);
			if (!current) return;
			const url = new URL(current.currentSrc || current.src, location.href);
			// Never a value this page has used, and not crypto.randomUUID, which
			// exists only in a secure context: the site is also read over plain
			// HTTP from a development server on the LAN, where it is undefined
			// and the button would throw. The time makes a repeat impossible.
			url.searchParams.set(
				"replay",
				`${Date.now().toString(36)}${Math.random().toString(36).slice(2)}`,
			);
			// A new element as well as a new address. An engine that keeps an
			// animation's state with the element, rather than with the picture it
			// shows, would otherwise go on showing the last frame. It is swapped
			// in once the picture has loaded, so the card never blanks, and loads
			// eagerly because a lazy image outside the document may never load.
			const fresh = current.cloneNode() as HTMLImageElement;
			fresh.loading = "eager";
			fresh.addEventListener("load", () => current.replaceWith(fresh), {
				once: true,
			});
			fresh.src = url.href;
		});
		button.hidden = false;
	}
</script>

<style>
	.rb-card {
		margin-block: 1rem;
	}
	.rb-card img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	.rb-card__replay {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-block-start: 0.5rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-text);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.rb-card__replay:hover {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-white);
	}
	.rb-card__replay[hidden] {
		display: none;
	}
	/* The cards themselves stop animating under this preference, so a button
	 * that replays nothing would be a control with no effect. */
	@media (prefers-reduced-motion: reduce) {
		.rb-card__replay {
			display: none;
		}
	}
</style>
