---
/**
 * One picture of the card, and for the layouts that animate, a way to see the
 * animation again.
 *
 * The pictures are the SVG the tool writes, loaded as images rather than
 * inlined: ten of them on one page would put ten `<style>` blocks into one
 * document, and they share class and keyframe names (`m0`, `m1`),
 * so the last one would restyle the other nine. An image is a document of its
 * own, which is what keeps each card's animation to itself.
 *
 * The same isolation is why replaying takes a new image rather than a class:
 * nothing on the page can reach inside an image to restart its animations. So
 * the button swaps the image for a new one under a query it has never used,
 * which the browser treats as a new picture and animates from the start. A new
 * query on every press, and not two alternated: once both of two URLs had been
 * shown, Safari kept each decoded picture and handed the same one back already
 * at its last frame, so only the first press replayed anything. The cost of a
 * press is one download of a few kilobytes.
 *
 * The button is present only where there is something to replay. On a card
 * that does not move it would be a control that does nothing, and it starts
 * hidden so a reader without JavaScript never meets one either.
 *
 * A card that loops is never shown looping by default. It moves every few
 * seconds for as long as the page is open, and a movement that lasts that long
 * needs a way to stop it (WCAG 2.2.2). So a `loop` card shows the picture that
 * plays once, and a toggle swaps both palettes to the looping picture and back,
 * which is the control: pressed again, the card is the one that settles. The
 * toggle alternates between two pictures by its nature, which is exactly what
 * broke replaying in Safari, so every swap, to the loop and back to once, loads
 * its picture under a query it has never used, the way a replay does.
 *
 * A layout can take both: `animated` and `loop` on one card. A replay while
 * the loop is on restarts the looping picture, and a swap made while a replay
 * is still loading wins over it, because both controls go through one swap
 * that remembers what each palette was last asked to show. That swap is also
 * what the toggle takes its pressed state from, once the picture the reader is
 * looking at is on the page: a picture that never loads leaves the card as it
 * was, and a control that said "looping" over the settled card would be
 * claiming something nobody can see.
 *
 * The twins invoke this component identically, which is what
 * `scripts/check-i18n-parity.mjs` compares, so the label's language is read off
 * the URL rather than passed in, the way `Figure.astro` reads it.
 */
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";

import { CARD_COMMAND_TEXT, cardCommand, cardStep } from "../lib/card-command.mjs";
import { BASE, localeOf } from "../lib/site.mjs";
import ThemeImage from "./ThemeImage.astro";

interface Props {
	/** The layout's name, which is the stem of its picture: card-<name>.svg. */
	name: string;
	/** What the picture shows, for a reader who cannot see it. */
	alt: string;
	/** Whether the layout animates, and so whether a replay button is offered. */
	animated?: boolean;
	/**
	 * Whether a toggle offers the looping picture, card-<name>-loop.svg. The
	 * picture shown until it is pressed is still card-<name>.svg, which plays
	 * once.
	 */
	loop?: boolean;
}

const { name, alt, animated = false, loop = false } = Astro.props;

const route = Astro.url.pathname
	.slice(BASE.length)
	.replace(/^\/+/, "")
	.replace(/\/+$/, "");
const locale = localeOf(route);

const urls = import.meta.glob<string>("../assets/card-*.svg", {
	query: "?url",
	import: "default",
	eager: true,
});
const sources = import.meta.glob<string>("../assets/card-*.svg", {
	query: "?raw",
	import: "default",
	eager: true,
});

// Both palettes, light as the plain name and dark with the `_dark` suffix. The
// dark URL is looked up rather than derived, because Vite puts a content hash
// into every asset URL and a suffix added after it names no file.
const key = `../assets/card-${name}.svg`;
const darkKey = `../assets/card-${name}_dark.svg`;
const src = urls[key];
const darkSrc = urls[darkKey];
const raw = sources[key];
if (!src || !darkSrc || !raw) {
	throw new Error(
		`<Card name="${name}" /> needs both src/assets/card-${name}.svg and card-${name}_dark.svg. ` +
			"Render the gallery with TestCardGallery (see the testing page) and copy them in.",
	);
}
const loopSrc = urls[`../assets/card-${name}-loop.svg`];
const loopDarkSrc = urls[`../assets/card-${name}-loop_dark.svg`];
if (loop && (!loopSrc || !loopDarkSrc)) {
	throw new Error(
		`<Card name="${name}" loop /> needs both src/assets/card-${name}-loop.svg and card-${name}-loop_dark.svg. ` +
			"Render the gallery with TestCardGallery (see the testing page) and copy them in.",
	);
}

// The card's own size, read off its root element, so the page reserves the box
// before the image arrives and nothing below it moves when it does.
const root = raw.match(/<svg\b[^>]*>/)?.[0] ?? "";
const width = Number(root.match(/\bwidth="(\d+)"/)?.[1]);
const height = Number(root.match(/\bheight="(\d+)"/)?.[1]);
if (!width || !height) {
	throw new Error(`src/assets/card-${name}.svg declares no width and height on its root.`);
}

const LABELS = {
	en: "Replay the animation",
	es: "Repetir la animación",
};
const label = LABELS[locale];
const LOOP_LABELS = {
	en: "Play in a loop",
	es: "Reproducir en bucle",
};
const loopLabel = LOOP_LABELS[locale];
const text = CARD_COMMAND_TEXT[locale];
// The pictures and their commands in the order the toggle below swaps them:
// the one that plays once, and, on a card that offers it, the looping one.
const variants = loop ? [false, true] : [false];
---

<figure class="rb-card" data-card>
	<ThemeImage
		light={src}
		dark={darkSrc}
		alt={alt}
		width={width}
		height={height}
	/>
	<div class="rb-card__controls not-content">
	{
		animated && (
			<button
				type="button"
				class="rb-card__replay"
				data-card-replay
				hidden
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M3 12a9 9 0 1 0 3-6.7" />
					<path d="M3 4v5h5" />
				</svg>
				<span>{label}</span>
			</button>
		)
	}
	{
		loop && (
			<button
				type="button"
				class="rb-card__replay rb-card__loop"
				aria-pressed="false"
				data-card-loop
				data-once-light={src}
				data-once-dark={darkSrc}
				data-loop-light={loopSrc}
				data-loop-dark={loopDarkSrc}
				hidden
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					width="16"
					height="16"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M17 2l4 4-4 4" />
					<path d="M3 11V10a4 4 0 0 1 4-4h14" />
					<path d="M7 22l-4-4 4-4" />
					<path d="M21 13v1a4 4 0 0 1-4 4H3" />
				</svg>
				<span>{loopLabel}</span>
			</button>
		)
	}
	<a
		class="rb-card__replay rb-card__open rb-card__open--light"
		href={src}
		data-card-open="light"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 24 24"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M15 3h6v6" />
			<path d="M9 21H3v-6" />
			<path d="M21 3l-7 7" />
			<path d="M3 21l7-7" />
		</svg>
		<span>{text.fullSize}<span class="sr-only">{text.fullSizeOf(name)}</span></span>
	</a>
	<a
		class="rb-card__replay rb-card__open rb-card__open--dark"
		href={darkSrc}
		data-card-open="dark"
	>
		<svg
			aria-hidden="true"
			viewBox="0 0 24 24"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M15 3h6v6" />
			<path d="M9 21H3v-6" />
			<path d="M21 3l-7 7" />
			<path d="M3 21l7-7" />
		</svg>
		<span>{text.fullSize}<span class="sr-only">{text.fullSizeOf(name)}</span></span>
	</a>
	</div>
	<div class="rb-card__command">
		<Tabs syncKey="card-command">
			<TabItem label={text.binary}>
				{
					variants.map((looping) => (
						<div
							data-card-command={looping ? "loop" : "once"}
							hidden={looping}
						>
							<Code
								code={cardCommand(name, looping)}
								lang="sh"
							/>
						</div>
					))
				}
			</TabItem>
			<TabItem label={text.action}>
				{
					variants.map((looping) => (
						<div
							data-card-command={looping ? "loop" : "once"}
							hidden={looping}
						>
							<Code
								code={cardStep(name, looping)}
								lang="yaml"
							/>
						</div>
					))
				}
			</TabItem>
		</Tabs>
	</div>
</figure>

<script>
	// One module however many cards the page holds: Astro bundles a component's
	// script once.

	// A query value this page has never used. The time sets it apart from every
	// value a previous visit used, and the counter from every value this one
	// has, so a repeat is impossible rather than unlikely. Not
	// crypto.randomUUID, which exists only in a secure context: the site is
	// also read over plain HTTP from a development server on the LAN, where it
	// is undefined and the buttons would throw.
	let minted = 0;
	const unused = () => `${Date.now().toString(36)}-${(minted++).toString(36)}`;

	// The address each palette of each card was last asked to show, by the
	// replay button or the loop toggle. A swap finishes only once its picture
	// has loaded, so until then the element on the page still shows the old
	// address, and a second press before the first has landed has to start
	// from what was asked for, not from what is on screen.
	const wanted = new WeakMap<Element, Map<string, string>>();

	/**
	 * Shows `address` in one palette of a card, as a picture the browser has
	 * never seen, so it plays from the start. It answers with what became of
	 * the swap, which is how a control that claims a state, the loop toggle,
	 * learns whether the reader can actually see it: `shown` once the picture
	 * is on the page, `failed` if it never loaded, `superseded` if another
	 * press asked for a different picture in the meantime.
	 */
	function show(
		figure: Element,
		selector: string,
		address: string,
	): Promise<"shown" | "failed" | "superseded"> {
		const current = figure.querySelector<HTMLImageElement>(selector);
		if (!current) return Promise.resolve("failed");
		const url = new URL(address, location.href);
		url.searchParams.set("replay", unused());
		const next = url.href;
		const asked = wanted.get(figure) ?? new Map<string, string>();
		wanted.set(figure, asked);
		const previous = asked.get(selector);
		asked.set(selector, next);
		// The palette out of sight is display:none, and a lazy image there is not
		// fetched until its palette is shown. Setting its address costs nothing,
		// and the picture arrives, from the start, when the theme changes.
		if (getComputedStyle(current).display === "none") {
			current.src = next;
			return Promise.resolve("shown");
		}
		// A new element as well as a new address. An engine that keeps an
		// animation's state with the element, rather than with the picture it
		// shows, would otherwise go on showing the last frame. It is swapped in
		// once the picture has loaded, so the card never blanks, and loads
		// eagerly because a lazy image outside the document may never load. It
		// replaces whatever holds the palette by then, which a later swap may
		// have replaced already, and not at all if a later press asked for
		// another picture.
		const fresh = current.cloneNode() as HTMLImageElement;
		fresh.loading = "eager";
		const settled = new Promise<"shown" | "failed" | "superseded">((resolve) => {
			fresh.addEventListener(
				"load",
				() => {
					if (asked.get(selector) !== next) {
						resolve("superseded");
						return;
					}
					figure.querySelector(selector)?.replaceWith(fresh);
					resolve("shown");
				},
				{ once: true },
			);
			// A picture that never arrives leaves the card showing what it showed
			// before, so what was asked for is taken back: the next press starts
			// from the address on screen rather than from one that failed.
			fresh.addEventListener(
				"error",
				() => {
					if (asked.get(selector) !== next) {
						resolve("superseded");
						return;
					}
					if (previous === undefined) asked.delete(selector);
					else asked.set(selector, previous);
					resolve("failed");
				},
				{ once: true },
			);
		});
		fresh.src = next;
		return settled;
	}

	const PALETTES = ["img.light-only", "img.dark-only"];

	/** The palette on screen. The other one is display:none. */
	const visiblePalette = (figure: Element) =>
		PALETTES.find((candidate) => {
			const image = figure.querySelector(candidate);
			return image && getComputedStyle(image).display !== "none";
		});

	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-card-replay]")) {
		const figure = button.closest("[data-card]");
		if (!figure?.querySelector("img")) continue;
		button.addEventListener("click", () => {
			// Reloading the palette out of sight would cost a download and replay
			// nothing anyone can see.
			const selector = visiblePalette(figure);
			const current = selector && figure.querySelector<HTMLImageElement>(selector);
			if (!selector || !current) return;
			// The picture this palette is meant to show, which is the looping one
			// while the toggle below is pressed, even before it has loaded.
			show(
				figure,
				selector,
				wanted.get(figure)?.get(selector) ?? (current.currentSrc || current.src),
			);
		});
		button.hidden = false;
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-card-loop]")) {
		const figure = button.closest("[data-card]");
		const { onceLight, onceDark, loopLight, loopDark } = button.dataset;
		if (!figure || !onceLight || !onceDark || !loopLight || !loopDark) continue;
		// What the reader asked for, kept here rather than read back off
		// aria-pressed: the attribute now follows the picture, which arrives a
		// moment later, and two quick presses would otherwise both read the state
		// before either had changed it and ask for the same thing twice.
		let looping = false;
		button.addEventListener("click", async () => {
			looping = !looping;
			const wantsLoop = looping;
			// Both palettes, so switching the page's theme while the card loops
			// shows the loop in the other palette too, and each under a new query
			// in both directions: the toggle alternates between two pictures, which
			// is the alternation that stopped Safari replaying (see the top of this
			// file), so the picture that plays once would come back already settled
			// the second time it was shown.
			const onScreen = visiblePalette(figure) ?? PALETTES[0];
			const swaps = await Promise.all([
				show(figure, PALETTES[0], wantsLoop ? loopLight : onceLight),
				show(figure, PALETTES[1], wantsLoop ? loopDark : onceDark),
			]);
			// The state is claimed from the palette the reader is looking at, and
			// only once its picture is on the page. A picture that never loads
			// leaves the card as it was, so the toggle says what it said before and
			// the next press tries the same swap again; a press that another press
			// has overtaken leaves the state to that one.
			const outcome = swaps[PALETTES.indexOf(onScreen)];
			if (outcome === "shown") {
				button.setAttribute("aria-pressed", String(wantsLoop));
				// The command under the card and the full-size link follow the
				// picture, at the moment the picture changes: a command that says
				// `-card-motion loop` under a card that settled would be a line
				// that draws something other than what the reader is looking at.
				for (const block of figure.querySelectorAll<HTMLElement>("[data-card-command]")) {
					block.hidden = (block.dataset.cardCommand === "loop") !== wantsLoop;
				}
				for (const link of figure.querySelectorAll<HTMLAnchorElement>("[data-card-open]")) {
					const dark = link.dataset.cardOpen === "dark";
					link.href = wantsLoop ? (dark ? loopDark : loopLight) : dark ? onceDark : onceLight;
				}
			}
			else if (outcome === "failed" && looping === wantsLoop) looping = !wantsLoop;
		});
		button.hidden = false;
	}
</script>

<style>
	.rb-card {
		margin-block: 1rem;
	}
	.rb-card img {
		display: block;
		max-width: 100%;
		height: auto;
	}
	/* The controls in one row that wraps, spaced by the row rather than by a
	 * margin on each control: which of them is on screen depends on JavaScript,
	 * the reader's motion preference and the page's theme, and a gap is only
	 * ever put between the ones that are. */
	.rb-card__controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-block-start: 0.5rem;
	}
	.rb-card__replay {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: transparent;
		color: var(--sl-color-text);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.rb-card__replay:hover {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-white);
	}
	.rb-card__loop[aria-pressed="true"] {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}
	.rb-card__replay[hidden] {
		display: none;
	}
	/* A link, not a button, so it takes the pill's look and loses the link
	 * underline. It is there with or without JavaScript and whatever the
	 * reader's motion preference, because opening a picture at its own size
	 * plays nothing. One per palette, and the one that does not belong to the
	 * page's theme is hidden the way theme-images.css hides its picture. */
	.rb-card__open {
		text-decoration: none;
	}
	:global([data-theme="light"]) .rb-card__open--dark,
	:global([data-theme="dark"]) .rb-card__open--light {
		display: none;
	}
	/* Under every one of a dozen pictures, the snippet is kept to what it
	 * says: the tab row close above the block, and a block two lines tall
	 * rather than padded the way a page's standalone example is. */
	.rb-card__command {
		margin-block-start: 0.75rem;
	}
	.rb-card__command :global(.expressive-code) {
		margin-block-start: 0.5rem;
	}
	.rb-card__command :global(.expressive-code pre) {
		padding-block: 0.25rem;
	}
	/* The cards themselves stop animating under this preference, so a button
	 * that replays nothing, or loops a picture that does not move, would be a
	 * control with no effect. The loop toggle carries this class too. */
	@media (prefers-reduced-motion: reduce) {
		.rb-card__replay:not(.rb-card__open) {
			display: none;
		}
	}
</style>
