---
/**
 * The compose file for the stack a reader wants, from the two questions that
 * decide it: which store, and whether Grafana comes with it.
 *
 * The files are not written here. They are generated by `cmd/gen_compose` into
 * `deploy/`, brought up by the end-to-end suite, and read from disk at build
 * time, so what this shows is what was tested rather than a copy of it.
 */
import { Code } from "@astrojs/starlight/components";
import { readFileSync, readdirSync } from "node:fs";
import { join } from "node:path";

interface Props {
  /** The words, so the Spanish twin says them in Spanish. */
  store: string;
  grafana: string;
  none: string;
  hint: string;
}

const { store, grafana, none, hint } = Astro.props;

const deploy = join(process.cwd(), "..", "deploy");
const files = Object.fromEntries(
  readdirSync(deploy)
    .filter((name) => name.endsWith(".yaml"))
    .map((name) => [name, readFileSync(join(deploy, name), "utf8")]),
);

/** Which file answers which pair of answers. */
const choices = [
  { store: "influxdb", label: "InfluxDB", withGrafana: "compose.influxdb-grafana.yaml", alone: "compose.influxdb.yaml" },
  { store: "postgres", label: "PostgreSQL", withGrafana: "compose.postgres-grafana.yaml", alone: "compose.postgres.yaml" },
  { store: "none", label: none, withGrafana: "compose.collector.yaml", alone: "compose.collector.yaml" },
];
---

<div class="compose-picker">
  <div class="compose-picker__controls">
    <label>
      {store}
      <select data-compose-store>
        {choices.map((choice) => <option value={choice.store}>{choice.label}</option>)}
      </select>
    </label>
    <label>
      <input
        type="checkbox"
        data-compose-grafana
        checked
      />
      {grafana}
    </label>
  </div>
  <p class="compose-picker__hint">{hint}</p>
  {
    choices.map((choice) =>
      [
        ["yes", choice.withGrafana],
        ["no", choice.alone],
      ].map(([wants, file]) => (
        <div
          data-compose-pane={`${choice.store}:${wants}`}
          hidden
        >
          <Code
            code={files[file]}
            lang="yaml"
            title="compose.yaml"
          />
        </div>
      )),
    )
  }
</div>

<script>
  // Plain DOM: the panes are all rendered and one is shown, so the page needs
  // no request and works from the first paint.
  for (const picker of document.querySelectorAll<HTMLElement>(".compose-picker")) {
    const store = picker.querySelector<HTMLSelectElement>("[data-compose-store]");
    const grafana = picker.querySelector<HTMLInputElement>("[data-compose-grafana]");
    if (!store || !grafana) continue;
    const show = () => {
      // The collector on its own has no Grafana to bring, so the checkbox is
      // not a question there and saying so beats letting it look answered.
      const alone = store.value === "none";
      grafana.disabled = alone;
      const wants = !alone && grafana.checked ? "yes" : "no";
      for (const pane of picker.querySelectorAll<HTMLElement>("[data-compose-pane]")) {
        pane.hidden = pane.dataset.composePane !== `${store.value}:${wants}`;
      }
    };
    store.addEventListener("change", show);
    grafana.addEventListener("change", show);
    show();
  }
</script>

<style>
  .compose-picker__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-block-end: 0.5rem;
  }
  .compose-picker__controls label {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
  }
  .compose-picker__hint {
    margin-block: 0 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
